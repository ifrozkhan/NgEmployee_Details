@page
@model InvoiceApp.Pages.Invoices.IndexModel
@{
}

<h2 class="text-center mb-3">Invoice</h2>
<a class="btn btn-primary" asp-page="/Invoices/Create">New Invoice</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Invoice No</th>
            <th>Status</th>
            <th>Client</th>
            <th>Total price</th>
            <th>Issue date</th>
            <th>DueDate</th>
            <th>Action</th>
        </tr>
        
    </thead>

    <tbody class="table-group-divider">
        @foreach(var invoice in Model.InvoiceList){
            <tr>
                <td>@invoice.Id</td>
                <td>@invoice.Number</td>
                <td>@invoice.Status</td>
                <td>@invoice.Clientname</td>
                <td>@invoice.Quamtity * @invoice.UintPrice</td>
                <td>@invoice.IssueDate</td>
                <td>@invoice.DueDate</td>
                <td style="white-space:nowrap">
                    <a class="btn btn-primary btn-sm" asp-page="/Invoice/Edit" asp-route-id="@invoice.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-page="/Invoice/Delete" asp-route-id="@invoice.Id">Delete</a>
                </td>

            </tr>
        }
    </tbody>
</table>
